{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dekc://schemas/okf-concepts/Diagram.schema.json",
  "title": "DEKC OKF concept: Diagram",
  "description": "Mermaid or PlantUML diagram embedded in Markdown.",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "type": {
      "const": "Diagram"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "verified": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "wiki_key": {
      "type": "string"
    },
    "truth_state": {
      "type": "string"
    },
    "diagram_kind": {
      "type": "string",
      "enum": [
        "wireframe",
        "architecture",
        "component",
        "activity",
        "state",
        "class",
        "erd",
        "sequence",
        "deployment",
        "flowchart",
        "c4"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "mermaid",
        "plantuml"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
