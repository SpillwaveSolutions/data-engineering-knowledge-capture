{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dekc://schemas/okf-concepts/Table.schema.json",
  "title": "DEKC OKF concept: Table",
  "description": "Physical or logical table in a medallion layer.",
  "type": "object",
  "required": [
    "type",
    "title",
    "description",
    "timestamp",
    "title"
  ],
  "properties": {
    "type": {
      "const": "Table"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "completed",
        "failed"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "Absolute in-bundle path e.g. /tables/foo.md"
          },
          "rel": {
            "type": "string",
            "description": "Typed edge relation"
          }
        },
        "additionalProperties": true
      }
    },
    "verified": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "wiki_key": {
      "type": "string"
    },
    "truth_state": {
      "type": "string",
      "enum": [
        "current",
        "historical",
        "proposed"
      ]
    },
    "owner": {
      "type": "string"
    },
    "cloud": {
      "type": "string",
      "enum": [
        "azure",
        "aws",
        "gcp",
        "multi",
        "onprem",
        "generic"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "raw",
        "sandbox",
        ""
      ]
    },
    "schema": {
      "type": "string"
    },
    "fqn": {
      "type": "string"
    },
    "sql_fingerprint": {
      "type": [
        "string",
        "integer",
        "number"
      ]
    },
    "format": {
      "type": "string",
      "description": "delta|iceberg|parquet|csv|..."
    }
  },
  "additionalProperties": true
}
